# Server Config
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# DB Config
DATABASE_URL=

# Security Config
ARCJET_ENV=development
ARCJET_KEY=

JWT_SECRET=
COOKIE_SECRET=

CORS_ORIGIN=http://localhost:5173

# Geocoding/POI discovery (Nominatim + Overpass) — optional, but both
# services' usage policy wants a real identifying User-Agent with contact
# info. Falls back to a generic string if unset (fine for local dev, not
# for anything more than light use).
OSM_USER_AGENT=Scout/1.0 (contact: tejassraman@gmail.com)

# Transit routing (OpenTripPlanner) — required for POST/GET /api/spaces/:id/route(s).
# See docker/otp/README.md to stand it up. Use 127.0.0.1, not localhost —
# Node 24 resolves "localhost" to ::1 first, and Docker Desktop's Windows
# port-forwarding for 8080:8080 doesn't reliably accept IPv6 loopback
# connections, so the request just hangs instead of failing or connecting.
OTP_URL=http://127.0.0.1:8080

POSTHOG_ENABLED=false
POSTHOG_PROJECT_TOKEN=phc_your_project_token
POSTHOG_HOST=https://us.i.posthog.com
# Optional dedicated HMAC secret for pseudonymous PostHog user IDs.
# When empty, the already-required JWT_SECRET is used with domain separation.
POSTHOG_IDENTITY_SECRET=
